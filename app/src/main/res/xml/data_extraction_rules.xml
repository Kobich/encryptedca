<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- AndroidKeyStore entries and noBackupFilesDir are not restored together.
         Do not restore a dangling profile index on API 31+. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="certificate_profiles.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="certificate_profiles.xml" />
    </device-transfer>
</data-extraction-rules>
