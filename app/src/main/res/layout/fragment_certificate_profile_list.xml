<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/profiles_title" android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium" />
    <TextView android:id="@+id/selection_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
    <TextView android:id="@+id/list_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp">
        <LinearLayout android:id="@+id/profile_rows" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <Button android:id="@+id/add_profile" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="@string/add_profile" />
</LinearLayout>
